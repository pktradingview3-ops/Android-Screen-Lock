<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only permission needed: set the wallpaper (normal permission, granted at install). -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!--
      Android 11+ package visibility.

      Without this, getInstalledApplications() and queryIntentActivities() only return
      apps that are already visible to us, so the app picker listed almost nothing but
      the OEM's own system apps - WhatsApp, Truecaller and other installed apps never
      appeared.

      These are <queries> declarations, NOT permissions: they grant no access to data,
      they only make the package list complete so the user can pick from it. Nothing is
      read from the apps themselves.
    -->
    <queries>
        <!-- Everything with a launcher icon: the apps a user would want to lock. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- The home screen, so it can be detected and refused as unsafe to lock. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Needed to read an app's label and icon for the list. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.INFO" />
        </intent>
    </queries>

    <application
        android:name=".TimeWallApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TimeWall">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Live wallpaper. Only the system (BIND_WALLPAPER) can bind to it. -->
        <service
            android:name=".wallpaper.TimeWallpaperService"
            android:exported="true"
            android:label="@string/live_wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/timewall_wallpaper" />
        </service>

        <!--
          Per-app lock. Watches which app comes to the foreground so it can lock the
          ones the user picked. The service reads only the package name from the
          window-state event; canRetrieveWindowContent is false in its config, so it
          never sees what is on the screen.
        -->
        <service
            android:name=".applock.AppLockAccessibilityService"
            android:exported="true"
            android:label="@string/app_lock_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/app_lock_service" />
        </service>

        <!--
          The unlock screen shown on top of a protected app. Not exported: only our
          own accessibility service starts it. noHistory + excludeFromRecents so it
          leaves no trace behind, and it never appears in the recents list.
        -->
        <activity
            android:name=".applock.AppUnlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:theme="@style/Theme.TimeWall" />

    </application>

</manifest>
